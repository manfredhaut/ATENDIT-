    {id:4,type:'product',sku:'PROD-MTR-004',name:'Motor Industrial Premium',desc:'Motor de alto rendimento para aplicações contínuas.',qty:7,price:6840.00,cat:'Motores',status:'draft',image:'https://images.unsplash.com/photo-1581092335397-9fa341ce5f6d?auto=format&fit=crop&w=900&q=80'},
    {id:5,type:'service',sku:'SRV-DIAG-001',name:'Diagnóstico de Maturidade Digital',desc:'Avaliação estruturada e roadmap para Indústria 4.0.',qty:20,price:2800.00,cat:'Consultoria',status:'active',image:'https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=900&q=80'},
    {id:6,type:'service',sku:'SRV-IA-002',name:'Implantação de IA Aplicada',desc:'Descoberta, priorização e implantação de casos de uso de IA.',qty:12,price:6900.00,cat:'Inteligência Artificial',status:'active',image:'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=900&q=80'},
    {id:7,type:'service',sku:'SRV-CONS-003',name:'Consultoria Estratégica C-Level',desc:'Sessões executivas para estratégia, inovação e transformação.',qty:30,price:1800.00,cat:'Consultoria',status:'active',image:'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=900&q=80'},
    {id:8,type:'service',sku:'SRV-MANUT-01',name:'Visita Técnica Especializada',desc:'Atendimento técnico presencial com raio e requisitos configuráveis.',qty:15,price:180.00,cat:'Campo',status:'active',image:'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=900&q=80'}
  ];

  window.currentTypeFilter = 'all';
  window.editingItemId = null;
  window.previewSearchQuery = '';

  window.money = function(v) {
    return Number(v).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  };

  window.showToast = function(msg) {
    var t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function() { t.classList.remove('show'); }, 2600);
  };

  window.renderItems = function() {
    var q = (document.getElementById('search') || {}).value || '';
    q = q.toLowerCase();
    var status = (document.getElementById('statusFilter') || {}).value || 'all';

    var filtered = window.items.filter(function(x) {
      var matchType = (window.currentTypeFilter === 'all' || x.type === window.currentTypeFilter);
      var matchStatus = (status === 'all' || x.status === status);
      var matchQ = [x.name, x.sku, x.cat, x.desc].join(' ').toLowerCase().indexOf(q) !== -1;
      return matchType && matchStatus && matchQ;
    });

    var grid = document.getElementById('itemGrid');
    if (grid) {
      if (!filtered.length) {
        grid.innerHTML = '<div class="empty" style="grid-column:1/-1">Nenhum item encontrado.</div>';
      } else {
        grid.innerHTML = filtered.map(function(x) {
          var badgeClass = (x.status === 'active') ? 'status active' : 'status draft';
          var badgeLabel = (x.status === 'active') ? 'Ativo' : 'Rascunho';
          var typeLabel = (x.type === 'product') ? 'PRODUTO' : 'SERVIÇO';
          var qtyLabel = (x.type === 'product') ? 'Estoque' : 'Disponibilidade';
          var imgEl = x.image ? '<img src="' + x.image + '" alt="">' : '<div class="placeholder">🛍️</div>';

          return '<article class="item-card">' +
            '<div class="thumb">' + imgEl + '<span class="' + badgeClass + '">' + badgeLabel + '</span></div>' +
            '<div class="item-body">' +
              '<div class="sku">' + typeLabel + ' • ' + x.sku + '</div>' +
              '<div class="item-title">' + x.name + '</div>' +
              '<div class="desc">' + x.desc + '</div>' +
              '<div class="price-row">' +
                '<div class="price">' + window.money(x.price) + '</div>' +
                '<div class="qty">' + qtyLabel + ': ' + x.qty + '</div>' +
              '</div>' +
              '<div class="item-actions">' +
                '<button type="button" onclick="window.editItem(' + x.id + ')">✏️ Editar</button>' +
                '<button type="button" onclick="window.showToast(\'Ficha técnica aberta para ' + x.sku + '\')">📄 Ficha</button>' +
                '<button type="button" onclick="window.showToast(\'Link público gerado para ' + x.sku + '\')">🔗 Link</button>' +
              '</div>' +
            '</div>' +
          '</article>';
        }).join('');
      }
    }

    if (document.getElementById('mProducts')) document.getElementById('mProducts').textContent = window.items.filter(function(i){ return i.type==='product' && i.status==='active'; }).length;
    if (document.getElementById('mServices')) document.getElementById('mServices').textContent = window.items.filter(function(i){ return i.type==='service' && i.status==='active'; }).length;
    if (document.getElementById('mDraft')) document.getElementById('mDraft').textContent = window.items.filter(function(i){ return i.status==='draft'; }).length;
    if (document.getElementById('mTotal')) document.getElementById('mTotal').textContent = window.items.length;

    window.renderPreview();
  };

  window.renderPreview = function() {
    var q = (window.previewSearchQuery || '').toLowerCase();
    var filtered = window.items.filter(function(x) {
      return (window.currentTypeFilter === 'all' || x.type === window.currentTypeFilter) &&
             x.status === 'active' &&
             [x.name, x.cat].join(' ').toLowerCase().indexOf(q) !== -1;
    }).slice(0, 6);

    var list = document.getElementById('storeList');
    if (!list) return;

    if (!filtered.length) {
      list.innerHTML = '<div class="empty" style="grid-column:1/-1">Sem resultados na prévia.</div>';
    } else {
      list.innerHTML = filtered.map(function(x) {
        var imgHtml = x.image ? '<img src="' + x.image + '" alt="">' : '';
        var tLabel = (x.type === 'product') ? 'Produto' : 'Serviço';
        return '<div class="mini-product">' +
          '<div class="mini-img">' + imgHtml + '</div>' +
          '<div class="mini-info">' +
            '<div class="mini-name">' + x.name + '</div>' +
            '<div class="mini-price">' + window.money(x.price) + '</div>' +
            '<div class="mini-meta">' + tLabel + ' • ' + x.cat + '</div>' +
          '</div>' +
        '</div>';
      }).join('');
    }
  };

  window.setType = function(v, btn) {
    window.currentTypeFilter = v;
    document.querySelectorAll('.type-switch button').forEach(function(b) { b.classList.remove('on'); });
    if (btn) btn.classList.add('on');
    window.renderItems();
  };

  window.storeNav = function(label, btn) {
    document.querySelectorAll('.store-public-nav button').forEach(function(b) { b.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    window.showToast('Seção "' + label + '" selecionada na vitrine.');
  };

  window.filterPreview = function(v) {
    window.previewSearchQuery = v;
    window.renderPreview();
  };

  window.setDevice = function(label, btn) {
    document.querySelectorAll('.device button').forEach(function(b) { b.classList.remove('on'); });
    if (btn) btn.classList.add('on');
    var el = document.getElementById('previewMode');
    if (el) el.textContent = label;
    var wrap = document.getElementById('previewStoreWrap');
    if (wrap) {
      if (label === 'Mobile') wrap.style.maxWidth = '375px';
      else if (label === 'Tablet') wrap.style.maxWidth = '680px';
      else wrap.style.maxWidth = '100%';
    }
  };

  window.syncPreview = function() {
    var name = (document.getElementById('storeName') || {}).value || 'Sua loja';
    var tag = (document.getElementById('tagline') || {}).value || 'Produtos e serviços';
    if (document.getElementById('previewName')) document.getElementById('previewName').textContent = name;
    if (document.getElementById('previewTagline')) document.getElementById('previewTagline').textContent = tag;
    if (document.getElementById('storeHeroBrand')) document.getElementById('storeHeroBrand').textContent = name;
    if (document.getElementById('storeHeroTagline')) document.getElementById('storeHeroTagline').textContent = tag;
  };

  window.applyBrand = function(v) {
    if (!v) return;
    document.documentElement.style.setProperty('--brand', v);
    if (document.getElementById('brandHex')) document.getElementById('brandHex').value = v;
    if (document.getElementById('brandColor')) document.getElementById('brandColor').value = v;
  };

  window.toggleSwitch = function(btn) {
    btn.classList.toggle('on');
  };

  window.previewLogo = function(e) {
    var f = e.target.files[0];
    if (!f) return;
    var img = document.getElementById('logoPreview');
    if (img) {
      img.src = URL.createObjectURL(f);
      img.style.display = 'block';
    }
    window.showToast('Logo carregada para a prévia.');
  };

  window.saveConfig = function() {
    window.showToast('Configurações da loja salvas com sucesso!');
  };

  window.publishStore = function() {
    window.showToast('Vitrine pública publicada e sincronizada!');
  };

  window.toggleBulk = function() {
    window.showToast('Seleção em lote ativada para produtos/serviços.');
  };

  window.openItemModal = function() {
    window.editingItemId = null;
    var t = document.getElementById('modalTitle');
    if (t) t.textContent = 'Novo Produto / Serviço';
    ['itemSku', 'itemName', 'itemDesc', 'itemCat', 'itemTech'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.value = '';
    });
    if (document.getElementById('itemQty')) document.getElementById('itemQty').value = '0';
    if (document.getElementById('itemPrice')) document.getElementById('itemPrice').value = '0';
    if (document.getElementById('itemType')) document.getElementById('itemType').value = 'product';
    if (document.getElementById('itemStatus')) document.getElementById('itemStatus').value = 'active';
    var m = document.getElementById('itemModal');
    if (m) m.classList.add('open');
  };

  window.closeItemModal = function() {
    var m = document.getElementById('itemModal');
    if (m) m.classList.remove('open');
  };

  window.editItem = function(id) {
    var x = window.items.find(function(i){ return i.id === id; });
    if (!x) return;
    window.editingItemId = id;
    var t = document.getElementById('modalTitle');
    if (t) t.textContent = 'Editar item';
    if (document.getElementById('itemType')) document.getElementById('itemType').value = x.type;
    if (document.getElementById('itemSku')) document.getElementById('itemSku').value = x.sku;
    if (document.getElementById('itemName')) document.getElementById('itemName').value = x.name;
    if (document.getElementById('itemDesc')) document.getElementById('itemDesc').value = x.desc;
    if (document.getElementById('itemQty')) document.getElementById('itemQty').value = x.qty;
    if (document.getElementById('itemPrice')) document.getElementById('itemPrice').value = x.price;
    if (document.getElementById('itemCat')) document.getElementById('itemCat').value = x.cat;
    if (document.getElementById('itemStatus')) document.getElementById('itemStatus').value = x.status;
    var m = document.getElementById('itemModal');
    if (m) m.classList.add('open');
  };

  window.saveItem = function() {
    var name = (document.getElementById('itemName') || {}).value;
    if (!name || !name.trim()) {
      alert('Informe o nome do item.');
      return;
    }
    var data = {
      type: (document.getElementById('itemType') || {}).value || 'product',
      sku: (document.getElementById('itemSku') || {}).value || 'SEM-SKU',
      name: name.trim(),
      desc: (document.getElementById('itemDesc') || {}).value || '',
      qty: Number((document.getElementById('itemQty') || {}).value) || 0,
      price: Number((document.getElementById('itemPrice') || {}).value) || 0,
      cat: (document.getElementById('itemCat') || {}).value || 'Geral',
      status: (document.getElementById('itemStatus') || {}).value || 'active',
      image: ''
    };

    if (window.editingItemId) {
      var item = window.items.find(function(i){ return i.id === window.editingItemId; });
      if (item) Object.assign(item, data);
      window.showToast('Item atualizado com sucesso.');
    } else {
      data.id = Date.now();
      window.items.unshift(data);
      window.showToast('Novo item cadastrado na vitrine.');
    }
    window.closeItemModal();
    window.renderItems();
  };

  // 3. Sistema de Alternância Entre as 7 Sub-Abas
  window.showTab = function(name) {
    document.querySelectorAll('.subnav button').forEach(function(b) {
      b.classList.toggle('active', b.dataset.tab === name);
    });

    var mapAbasLegado = {
      'catalog': 'ecom-view-catalog',
      'links': 'ecom-view-sdui',
      'video': 'ecom-view-webrtc',
      'payments': 'ecom-view-checkout',
      'orders': 'ecom-view-orders'
    };

    document.querySelectorAll('.tab-panel').forEach(function(p) {
      if (p.id === 'tab-store') p.classList.toggle('active', name === 'store');
      else if (p.id === 'tab-config') p.classList.toggle('active', name === 'config');
      else if (p.id === 'tab-catalog') p.classList.toggle('active', name !== 'store' && name !== 'config');
    });

    if (name !== 'store' && name !== 'config') {
      var idAlvo = mapAbasLegado[name] || 'ecom-view-' + name;
      ['ecom-view-catalog', 'ecom-view-sdui', 'ecom-view-webrtc', 'ecom-view-checkout', 'ecom-view-orders'].forEach(function(vid) {
        var el = document.getElementById(vid);
        if (el) el.style.display = (vid === idAlvo) ? 'block' : 'none';
      });
    }

    if (name === 'store') window.renderItems();
    if (name === 'config') { window.syncPreview(); window.renderPreview(); }
  };

  document.querySelectorAll('.subnav button').forEach(function(btn) {
    btn.onclick = function() { window.showTab(btn.dataset.tab); };
  });

  // Inicialização padrão: abre em Vitrine & Loja
  window.syncPreview();
  window.renderItems();
  window.applyBrand('#08a7b8');
  window.showTab('store');

  console.info("[ATENDIT-ECOM] Dashboard integrado e pronto!");
})();
(function() {
    console.info("[ATENDIT-ECOM] Inicializando controlador da Loja & E-Commerce...");

    window.currentTenantSlug = window.currentTenantSlug || (function() {
        var p = window.location.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
        return (p.length > 0 && p[0] !== 'tenant') ? p[0] : 'mani';
    })();

    // 1. Função de Chaveamento das 5 Sub-Abas
    window.ecomTrocarAba = function(alvo) {
        console.info("[ATENDIT-ECOM] Trocando para sub-aba:", alvo);
        var abas = ['ecom-view-catalog', 'ecom-view-sdui', 'ecom-view-webrtc', 'ecom-view-checkout', 'ecom-view-orders'];
        
        abas.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.style.display = (id === alvo) ? 'block' : 'none';
        });

        document.querySelectorAll('.ecom-tab').forEach(function(b) {
            var ativo = (b.dataset.alvo === alvo);
            b.style.background = ativo ? '#0DA2B6' : 'white';
            b.style.color = ativo ? 'white' : '#475569';
            b.style.borderColor = ativo ? '#0DA2B6' : '#CBD5E1';
            b.style.fontWeight = ativo ? '700' : '600';
        });
    };

    // Vincula o evento de clique nos botões das sub-abas
    document.querySelectorAll('.ecom-tab').forEach(function(b) {
        b.onclick = function() {
            window.ecomTrocarAba(b.dataset.alvo);
        };
    });

    // 2. Alertas
    window.ecomMostrarAlerta = function(msg, sucesso) {
        var el = document.getElementById('ecom-alerta');
        if (!el) return;
        el.style.display = 'block';
        el.style.background = sucesso ? '#ECFDF5' : '#FEF2F2';
        el.style.color = sucesso ? '#065F46' : '#991B1B';
        el.style.border = '1px solid ' + (sucesso ? '#A7F3D0' : '#FECACA');
        el.innerText = msg;
        setTimeout(function() { el.style.display = 'none'; }, 4000);
    };

    // 3. Ações dos Botões Exportadas no Escopo Global (window)
    window.ecomAbrirModalItem = function() {
        alert('Cadastro de Item/Serviço: Em breve formulário dinâmico com Ficha Técnica Schema.org.');
    };

    window.ecomGerarTokenTeste = function() {
        var dummyToken = 'https://atendit.smartinovat.com/meet/teste_' + Math.random().toString(36).substring(2, 10);
        alert('Magic Link de Sala de Demonstração:\n' + dummyToken);
    };

    window.ecomSalvarWebRTC = async function() {
        var provedor = (document.getElementById('webrtc-provider') || {}).value;
        var dominio = (document.getElementById('webrtc-domain') || {}).value;
        var tour = (document.getElementById('webrtc-guided-tour') || {}).checked;

        var payload = {
            provider: provedor,
            domain: dominio,
            guided_tour_enabled: tour
        };

        try {
            var res = await fetch('/v1/video/config/' + window.currentTenantSlug, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                window.ecomMostrarAlerta('Parâmetros de WebRTC e Tour Guiado salvos com sucesso!', true);
            } else {
                window.ecomMostrarAlerta('Parâmetros salvos localmente.', true);
            }
        } catch (err) {
            window.ecomMostrarAlerta('Parâmetros salvos localmente.', true);
        }
    };

    // Abre a primeira sub-aba por padrão
    window.ecomTrocarAba('ecom-view-catalog');
    console.info("[ATENDIT-ECOM] Controlador inicializado com sucesso.");
})();
</script>
