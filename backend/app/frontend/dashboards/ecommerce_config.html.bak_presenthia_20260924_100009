}
.store-public-nav button:hover { background: #f2f7f9; color: #0b7e8c; }
.store-public-nav button.active { background: #ecfbfd; color: #078493; }

.page-head {
  display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin: 20px 0;
}
.page-head h2 { margin: 0 0 6px; font-size: 26px; color: #071835; font-weight: 800; }
.page-head p { margin: 0; color: #62738d; font-size: 14px; }

.grid-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 22px; }
.metric { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); }
.metric .label { font-size: 13px; color: var(--muted); font-weight: 700; text-transform: uppercase; }
.metric .value { font-size: 30px; font-weight: 900; color: #091a38; margin: 8px 0 4px; }
.metric .sub { font-size: 12px; color: #6f8097; }

.panel { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 20px; }
.panel-head {
  display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid var(--line);
}
.panel-head h3 { margin: 0; font-size: 17px; color: #0b1932; font-weight: 800; }
.panel-head small { color: #7b8ba0; font-size: 12px; }

.controls { display: flex; gap: 10px; flex-wrap: wrap; padding: 15px 20px; border-bottom: 1px solid #edf1f5; align-items: center; }
.search { flex: 1; min-width: 210px; }
.search input { width: 100%; padding: 11px 13px; border: 1px solid var(--line); border-radius: 10px; outline: none; background: #fbfcfe; box-sizing: border-box; }
.controls select { padding: 11px 13px; border: 1px solid var(--line); border-radius: 10px; background: #fbfcfe; box-sizing: border-box; }

.type-switch { display: flex; background: #eef4f7; border-radius: 10px; padding: 4px; gap: 2px; }
.type-switch button { border: 0; background: transparent; padding: 8px 14px; border-radius: 8px; font-weight: 800; color: #587087; cursor: pointer; }
.type-switch button.on { background: #fff; color: var(--brand-2); box-shadow: 0 2px 7px rgba(0,0,0,.07); }

.items { padding: 18px 20px; }
.item-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
.item-card { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: #fff; display: flex; flex-direction: column; }
.thumb { height: 172px; background: linear-gradient(135deg, #edf7f8, #dceef1); position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.thumb .placeholder { font-size: 56px; opacity: .55; }
.status { position: absolute; top: 11px; right: 11px; font-size: 11px; font-weight: 900; padding: 6px 10px; border-radius: 999px; }
.status.active { background: #dcfaec; color: #087a4b; }
.status.draft { background: #fff2d9; color: #9a6400; }
.item-body { padding: 16px; display: flex; flex-direction: column; flex: 1; }
.sku { font-size: 11px; color: #718196; font-weight: 800; text-transform: uppercase; }
.item-title { font-size: 17px; font-weight: 900; color: #10203c; margin: 4px 0; }
.desc { font-size: 12px; color: #6c7c91; line-height: 1.45; min-height: 35px; }
.price-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 14px; }
.price { font-size: 20px; font-weight: 900; color: #008b6a; }
.qty { font-size: 11px; color: #718196; font-weight: 700; }
.item-actions { display: flex; gap: 8px; margin-top: 14px; }
.item-actions button { flex: 1; padding: 9px; border: 1px solid var(--line); background: #fff; border-radius: 8px; font-size: 12px; font-weight: 800; cursor: pointer; }
.item-actions button:hover { border-color: #9eb1c7; background: #f8fafc; }

.primary { background: var(--brand); color: #fff; border: 0; border-radius: 11px; padding: 12px 18px; font-weight: 800; cursor: pointer; box-shadow: 0 7px 18px rgba(8,167,184,.22); font-size: 14px; }
.secondary { background: #fff; color: #20304c; border: 1px solid var(--line); border-radius: 10px; padding: 11px 15px; font-weight: 700; cursor: pointer; font-size: 13px; }

.config { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px; }
.form { padding: 20px; }
.section-title { font-weight: 900; font-size: 14px; color: #0d1c38; margin-bottom: 14px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field.full { grid-column: 1 / -1; }
.field label { font-size: 12px; color: #52647b; font-weight: 800; }
.field input, .field select, .field textarea {
  width: 100%; padding: 10px 11px; border: 1px solid var(--line); border-radius: 9px; background: #fff; outline: none; color: #1c2f4c; box-sizing: border-box; font-family: inherit;
}
.field textarea { min-height: 84px; resize: vertical; }

.toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 15px; padding: 12px 0; border-bottom: 1px solid #edf1f5; }
.toggle-row:last-child { border-bottom: 0; }
.toggle-row strong { font-size: 13px; }
.toggle-row span { display: block; font-size: 11px; color: #73849a; margin-top: 2px; }

.switch { width: 42px; height: 23px; border-radius: 999px; background: #cbd5e1; position: relative; border: 0; flex: 0 0 auto; cursor: pointer; transition: .2s; }
.switch:after { content: ""; width: 17px; height: 17px; border-radius: 50%; background: #fff; position: absolute; top: 3px; left: 3px; box-shadow: 0 1px 3px rgba(0,0,0,.2); transition: .2s; }
.switch.on { background: var(--brand); }
.switch.on:after { left: 22px; }

.color-row { display: flex; gap: 10px; align-items: center; }
.color-box { width: 42px; height: 38px; padding: 2px; border: 1px solid var(--line); border-radius: 9px; background: #fff; cursor: pointer; }
.logo-drop { border: 1px dashed #b7c8d9; border-radius: 11px; padding: 17px; text-align: center; color: #72849a; background: #fbfdff; }
.logo-drop img { max-height: 54px; max-width: 180px; display: none; margin: auto; }

.pub-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.pub { border: 1px solid var(--line); border-radius: 12px; padding: 13px; background: #fbfdff; }
.pub strong { display: block; font-size: 12px; }
.pub p { margin: 4px 0 10px; font-size: 11px; color: #73849a; }
.pub a { font-size: 11px; color: var(--brand-2); font-weight: 800; text-decoration: none; }

.preview-panel { margin-top: 20px; }
.preview-header-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.preview-top { display: flex; align-items: center; justify-content: space-between; padding: 12px 15px; border-bottom: 1px solid var(--line); }
.device { display: flex; gap: 5px; }
.device button { border: 1px solid var(--line); background: #fff; border-radius: 8px; padding: 7px 9px; cursor: pointer; }
.device button.on { border-color: #89dce3; background: #edfcfd; color: #007e8d; font-weight: bold; }

.store { margin: 15px; border: 1px solid #e0e7ee; border-radius: 15px; overflow: hidden; background: #f9fbfd; max-width: 100%; transition: max-width 0.25s ease; }
.store-banner { min-height: 146px; padding: 20px; display: flex; align-items: flex-end; background: linear-gradient(135deg, var(--brand), #065d6b); color: #fff; }
.store-banner h3 { margin: 0 0 4px; font-size: 24px; font-weight: 900; }
.store-banner p { margin: 0; opacity: .86; font-size: 12px; }
.store-nav { background: #fff; padding: 10px 13px; display: flex; gap: 8px; border-bottom: 1px solid #e5ebf0; }
.store-nav span { font-size: 11px; font-weight: 800; color: #61748c; }
.store-nav span.active { color: var(--brand-2); }
.store-tools { display: flex; gap: 8px; padding: 13px; background: #fff; }
.store-tools input, .store-tools select { border: 1px solid var(--line); border-radius: 9px; padding: 9px; font-size: 12px; box-sizing: border-box; }
.store-tools input { flex: 1; }
.store-list { padding: 13px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.mini-product { background: #fff; border: 1px solid #e3e9ef; border-radius: 11px; overflow: hidden; }
.mini-img { height: 98px; background: #eaf6f7; }
.mini-img img { width: 100%; height: 100%; object-fit: cover; }
.mini-info { padding: 9px; }
.mini-name { font-size: 12px; font-weight: 900; line-height: 1.25; }
.mini-price { font-size: 13px; color: #008b6a; font-weight: 900; margin-top: 5px; }
.mini-meta { font-size: 10px; color: #8090a2; margin-top: 4px; }

.modal { position: fixed; inset: 0; background: rgba(5,14,28,.55); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 20px; }
.modal.open { display: flex; }
.dialog { width: min(760px, 100%); max-height: 92vh; overflow-y: auto; background: #fff; border-radius: 18px; box-shadow: 0 24px 70px rgba(0,0,0,.25); }
.dialog-head { padding: 18px 20px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; }
.dialog-head h3 { margin: 0; font-size: 18px; font-weight: 800; color: #0c1830; }
.close { border: 0; background: #eef2f6; border-radius: 8px; padding: 7px 10px; cursor: pointer; font-weight: bold; }
.dialog-body { padding: 20px; }
.dialog-foot { padding: 15px 20px; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 9px; }

.toast { position: fixed; right: 22px; bottom: 22px; background: #0c1830; color: #fff; padding: 13px 18px; border-radius: 10px; opacity: 0; transform: translateY(10px); pointer-events: none; transition: .22s; z-index: 10000; font-size: 13px; font-weight: 600; }
.toast.show { opacity: 1; transform: translateY(0); }
.empty { padding: 34px; text-align: center; color: #718196; }

@media (max-width: 1050px) {
  .grid-metrics { grid-template-columns: repeat(2, 1fr); }
  .config { grid-template-columns: 1fr; }
}
@media (max-width: 700px) {
  .grid-metrics { grid-template-columns: 1fr; }
  .item-grid { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
  .pub-grid { grid-template-columns: 1fr; }
}
</style>

