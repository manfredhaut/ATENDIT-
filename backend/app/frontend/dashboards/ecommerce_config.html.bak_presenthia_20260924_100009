  --card: #ffffff;
  --line: #d9e2ec;
  --success: #10b981;
  --warning: #f59e0b;
  --danger: #ef4444;
  --shadow: 0 8px 24px rgba(15,31,55,.08);
  --radius: 16px;
}
.subnav {
  display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--line);
  padding-bottom: 14px; overflow-x: auto; margin-bottom: 20px;
}
.subnav button {
