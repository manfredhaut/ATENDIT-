}
.store-hero-content { padding: 28px 30px; }
.store-hero-brand { font-size: 32px; font-weight: 900; letter-spacing: -.4px; }
.store-hero-tagline { margin-top: 8px; font-size: 15px; opacity: .92; }

.store-public-nav {
