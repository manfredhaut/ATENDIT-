<script>
(function() {
    "use strict";
    function obterTenantId() {
        if (window.currentTenantData && window.currentTenantData.id) return window.currentTenantData.id;
        if (window.currentTenantSlug) return window.currentTenantSlug;
        return null;
    }

    async function carregarDocumentos() {
        const tenantId = obterTenantId();
        const corpo = document.getElementById("rag-documents-tbody");
        if (!corpo) return;
        if (!tenantId) {
            corpo.innerHTML = '<tr><td colspan="5" class="text-center text-muted p-3">Carregando contexto...</td></tr>';
            return;
        }
        corpo.innerHTML = '<tr><td colspan="5" class="text-center p-3 text-muted">Consultando repositório vetorial...</td></tr>';
        try {
            const resp = await fetch('/v1/rag/documents/' + tenantId, { headers: { "Accept": "application/json" } });
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            const docs = await resp.json();
            corpo.innerHTML = "";
            if (!docs || docs.length === 0) {
                corpo.innerHTML = '<tr><td colspan="5" class="text-center p-4 text-muted">Nenhum documento vetorizado.</td></tr>';
                return;
            }
            docs.forEach(function(d) {
                const tr = document.createElement("tr");
                tr.innerHTML = '<td class="fw-semibold">' + d.filename + '</td>' +
                               '<td>' + (d.file_size / 1024).toFixed(1) + ' KB</td>' +
                               '<td><span class="badge bg-success">' + d.status + '</span></td>' +
                               '<td>' + d.created_at + '</td>' +
                               '<td class="text-end"><button class="btn btn-outline-danger btn-sm" onclick="excluirDocRAG(\'' + d.id + '\')">Excluir</button></td>';
                corpo.appendChild(tr);
            });
        } catch(e) {
            corpo.innerHTML = '<tr><td colspan="5" class="text-center text-danger p-3">Repositório vazio ou aguardando upload.</td></tr>';
        }
    }

    window.excluirDocRAG = async function(docId) {
        if (!confirm("Expurgar este documento da base de conhecimento?")) return;
        const tenantId = obterTenantId();
        try {
            const res = await fetch('/v1/rag/documents/' + tenantId + '/' + docId, { method: "DELETE" });
            if (!res.ok) throw new Error('HTTP ' + res.status);
            await carregarDocumentos();
        } catch(e) {
            alert('Falha ao excluir: ' + e.message);
        }
    };

    window.recarregarDocumentosRAG = carregarDocumentos;
    setTimeout(carregarDocumentos, 400);
})();
</script>
