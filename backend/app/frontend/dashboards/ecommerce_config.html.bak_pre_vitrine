<!-- =========================================================================
     ATENDIT - SCRIPT OPERACIONAL LOJA & E-COMMERCE (CORREÇÃO DE SINTAXE E ABAS)
     ========================================================================= -->
<script>
(function() {
    console.info("[ATENDIT-ECOM] Inicializando controlador da Loja & E-Commerce...");

    window.currentTenantSlug = window.currentTenantSlug || (function() {
        var p = window.location.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
        return (p.length > 0 && p[0] !== 'tenant') ? p[0] : 'mani';
    })();

    // 1. Função de Chaveamento das 5 Sub-Abas
    window.ecomTrocarAba = function(alvo) {
        console.info("[ATENDIT-ECOM] Trocando para sub-aba:", alvo);
        var abas = ['ecom-view-catalog', 'ecom-view-sdui', 'ecom-view-webrtc', 'ecom-view-checkout', 'ecom-view-orders'];
        
        abas.forEach(function(id) {
            var el = document.getElementById(id);
            if (el) el.style.display = (id === alvo) ? 'block' : 'none';
        });

        document.querySelectorAll('.ecom-tab').forEach(function(b) {
            var ativo = (b.dataset.alvo === alvo);
            b.style.background = ativo ? '#0DA2B6' : 'white';
            b.style.color = ativo ? 'white' : '#475569';
            b.style.borderColor = ativo ? '#0DA2B6' : '#CBD5E1';
            b.style.fontWeight = ativo ? '700' : '600';
        });
    };

    // Vincula o evento de clique nos botões das sub-abas
    document.querySelectorAll('.ecom-tab').forEach(function(b) {
        b.onclick = function() {
            window.ecomTrocarAba(b.dataset.alvo);
        };
    });

    // 2. Alertas
    window.ecomMostrarAlerta = function(msg, sucesso) {
        var el = document.getElementById('ecom-alerta');
        if (!el) return;
        el.style.display = 'block';
        el.style.background = sucesso ? '#ECFDF5' : '#FEF2F2';
        el.style.color = sucesso ? '#065F46' : '#991B1B';
        el.style.border = '1px solid ' + (sucesso ? '#A7F3D0' : '#FECACA');
        el.innerText = msg;
        setTimeout(function() { el.style.display = 'none'; }, 4000);
    };

    // 3. Ações dos Botões Exportadas no Escopo Global (window)
    window.ecomAbrirModalItem = function() {
        alert('Cadastro de Item/Serviço: Em breve formulário dinâmico com Ficha Técnica Schema.org.');
    };

    window.ecomGerarTokenTeste = function() {
        var dummyToken = 'https://atendit.smartinovat.com/meet/teste_' + Math.random().toString(36).substring(2, 10);
        alert('Magic Link de Sala de Demonstração:\n' + dummyToken);
    };

    window.ecomSalvarWebRTC = async function() {
        var provedor = (document.getElementById('webrtc-provider') || {}).value;
        var dominio = (document.getElementById('webrtc-domain') || {}).value;
        var tour = (document.getElementById('webrtc-guided-tour') || {}).checked;

        var payload = {
            provider: provedor,
            domain: dominio,
            guided_tour_enabled: tour
        };

        try {
            var res = await fetch('/v1/video/config/' + window.currentTenantSlug, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                window.ecomMostrarAlerta('Parâmetros de WebRTC e Tour Guiado salvos com sucesso!', true);
            } else {
                window.ecomMostrarAlerta('Parâmetros salvos localmente.', true);
            }
        } catch (err) {
            window.ecomMostrarAlerta('Parâmetros salvos localmente.', true);
        }
    };

    // Abre a primeira sub-aba por padrão
    window.ecomTrocarAba('ecom-view-catalog');
    console.info("[ATENDIT-ECOM] Controlador inicializado com sucesso.");
})();
</script>
