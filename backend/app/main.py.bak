@app.get("/LOGO ATENDIT STICH.jpg", include_in_schema=False)
@app.get("/LOGO%20ATENDIT%20STICH.jpg", include_in_schema=False)
def serve_logo():
    for name in ["LOGO ATENDIT STICH.jpg", "image_772e18.jpg"]:
        logo_path = FRONTEND_DIR / name
        if logo_path.is_file():
            return FileResponse(str(logo_path), media_type="image/jpeg")
    return JSONResponse(status_code=404, content={"error": "Logo not found"})

@app.post("/v1/auth/register")
async def auth_register(request: Request):
    try:
        body = await request.json()
    except Exception:
        return JSONResponse(status_code=400, content={"status": "error", "message": "JSON inválido"})
    name = body.get("name", "").strip()
    email = body.get("email", "").strip()
    slug = body.get("slug", "").strip().lower()
    if not slug:
        slug = re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')
    if not slug:
        slug = "empresa"
    if slug in RESERVED_ROUTES:
        slug = f"{slug}-app"

    store = get_tenants_store()
    if slug not in store:
        store[slug] = {
            "slug": slug,
            "name": name,
            "email": email,
            "phone": "",
            "ai_number": "",
            "status": "Operacional",
            "agent_config": {
                "name": name,
                "tone": "Objetivo e Claro",
                "questions": ["Qual seu nome?", "Qual o assunto do contato?", "Você já é associado?"]
            }
        }
    else:
        store[slug]["email"] = email
        if name:
            store[slug]["name"] = name
    save_tenants_store(store)
    return {"status": "success", "tenant_slug": slug, "token": f"atendit-token-{slug}-2026", "tenant": store[slug]}

@app.get("/v1/tenants/")
def list_tenants():
    return get_tenants_store()

@app.get("/v1/tenants/{tenant_slug}")
def get_tenant(tenant_slug: str):
    slug_clean = tenant_slug.strip().lower()
    store = get_tenants_store()
    if slug_clean in store:
        return store[slug_clean]
    return {
        "slug": slug_clean,
        "name": slug_clean.capitalize(),
        "email": "",
        "phone": "",
        "ai_number": "",
        "status": "Operacional",
        "agent_config": {
            "name": slug_clean.capitalize(),
            "tone": "Objetivo e Claro",
            "questions": ["Qual seu nome?", "Qual o assunto do contato?", "Você já é associado?"]
        }
    }

@app.post("/v1/tenants/update")
async def update_tenant(request: Request):
    try:
        body = await request.json()
    except Exception:
        return JSONResponse(status_code=400, content={"status": "error", "message": "JSON inválido"})
    slug = body.get("slug", "").strip().lower()
    if not slug:
        return JSONResponse(status_code=400, content={"status": "error", "message": "Slug é obrigatório"})
    store = get_tenants_store()
    if slug not in store:
        store[slug] = {"slug": slug, "status": "Operacional", "agent_config": {}}
    store[slug]["name"] = body.get("name", store[slug].get("name", ""))
    store[slug]["email"] = body.get("email", store[slug].get("email", ""))
    store[slug]["phone"] = body.get("phone", store[slug].get("phone", ""))
    store[slug]["ai_number"] = body.get("ai_number", store[slug].get("ai_number", ""))
    save_tenants_store(store)
    return {"status": "success", "message": "Dados cadastrais atualizados com sucesso!", "tenant": store[slug]}

@app.post("/v1/agent/config")
async def save_agent_config(request: Request):
    try:
        body = await request.json()
    except Exception:
        return JSONResponse(status_code=400, content={"status": "error", "message": "JSON inválido"})
    slug = body.get("slug", "").strip().lower()
    if not slug:
        return JSONResponse(status_code=400, content={"status": "error", "message": "Slug é obrigatório"})

    questions = body.get("questions", "[]")
    if isinstance(questions, str):
        try:
            questions = json.loads(questions)
        except Exception:
            questions = [questions]

    store = get_tenants_store()
    if slug not in store:
        store[slug] = {"slug": slug, "name": slug, "email": "", "phone": "", "status": "Operacional"}

    store[slug]["agent_config"] = {
        "name": body.get("agent_name", store[slug].get("name", "Atendente Virtual")),
        "tone": body.get("tone", "Objetivo e Claro"),
        "questions": questions
    }
    save_tenants_store(store)
    return {"status": "success", "message": "Parâmetros da IA gravados!", "tenant": store[slug]}

@app.post("/v1/whatsapp/qrcode")
async def generate_wa_qrcode(request: Request):
    try:
        body = await request.json()
    except Exception:
        body = {}
    slug = body.get("slug", "default").strip().lower()
    instance_name = ensure_evolution_instance(slug)

    connect_res = {}
    for attempt in range(4):
        time.sleep(1.5)
        connect_res = call_evolution_api(f"/instance/connect/{instance_name}", method="GET")
        if isinstance(connect_res, dict) and (connect_res.get("base64") or (isinstance(connect_res.get("qrcode"), dict) and connect_res["qrcode"].get("base64"))):
            break

    base64_qr = None
    if isinstance(connect_res, dict):
        base64_qr = connect_res.get("base64")
        if not base64_qr and isinstance(connect_res.get("qrcode"), dict):
            base64_qr = connect_res["qrcode"].get("base64")

    if not base64_qr:
        return JSONResponse(status_code=400, content={
            "status": "error",
            "message": "A Evolution API está iniciando a sessão. Clique novamente em 'Gerar Código QR' em 3 segundos."
        })

    return {"status": "success", "slug": slug, "instance_name": instance_name, "qrcode_url": base64_qr}

@app.post("/v1/whatsapp/pair-code")
async def generate_wa_pair_code(request: Request):
    try:
        body = await request.json()
    except Exception:
        body = {}
    slug = body.get("slug", "default").strip().lower()
    raw_phone = body.get("phone", "").strip()
    clean_phone = re.sub(r'[^0-9]', '', raw_phone)

    if not clean_phone:
        return JSONResponse(status_code=400, content={"status": "error", "message": "Número de telefone inválido"})

    instance_name = ensure_evolution_instance(slug)

    pair_res = {}
    for attempt in range(4):
        time.sleep(1.5)
        pair_res = call_evolution_api(f"/instance/connect/{instance_name}?number={clean_phone}", method="GET")
        if isinstance(pair_res, dict) and (pair_res.get("pairingCode") or pair_res.get("code")):
            break

    pair_code = None
    if isinstance(pair_res, dict):
        pair_code = pair_res.get("pairingCode") or pair_res.get("code")

    if not pair_code or (isinstance(pair_res, dict) and pair_res.get("count") == 0):
        return JSONResponse(status_code=400, content={
            "status": "error",
            "message": "A Evolution API está registrando o número. Clique novamente em 'Gerar Token' em 3 segundos."
        })

    store = get_tenants_store()
    if slug in store:
        store[slug]["ai_number"] = raw_phone
        save_tenants_store(store)

    return {"status": "success", "slug": slug, "phone": clean_phone, "pairing_code": pair_code}

@app.get("/dashboards/{view_name}", include_in_schema=False)
async def get_dashboard_view(view_name: str):
    safe_name = os.path.basename(view_name.strip()).replace(".html", "")
    target_file = (DASHBOARDS_DIR / f"{safe_name}.html").resolve()
    if not str(target_file).startswith(str(DASHBOARDS_DIR.resolve())) or not target_file.is_file():
        return JSONResponse(status_code=404, content={"error": f"Dashboard '{view_name}' not found"})
    with open(target_file, "r", encoding="utf-8") as f:
        return JSONResponse(content=f.read())

